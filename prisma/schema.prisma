generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["beverage"]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // JSON for org-wide lookup values and settings
  settingsBottleSizes  String @default("[200,355,375,500,700,750,1000,1500]")
  settingsCaseSizes    String @default("[1,6,12,24]")
  settingsCategories   String @default("[]")
  // Standard pour sizes per product type (JSON: { "SPIRIT": 1.5, "WINE": 5, ... } in fl oz)
  settingsStandardPours String @default("{\"SPIRIT\":1.5,\"WINE\":5,\"BEER\":12,\"NA_BEVERAGE\":8,\"CORDIAL\":1,\"BITTER\":0.04,\"SYRUP\":0.5,\"GROCERY\":1,\"PRODUCE\":1,\"MEAT\":1,\"DAIRY\":1,\"DRY_GOODS\":1,\"OTHER\":1}")
  // Custom shelf labels (JSON array of strings users can pick from)
  settingsShelfLabels   String @default("[]")
  // Ordering: merge all store orders into one cart
  useMergedOrderCart    Boolean @default(false)
  // Finans Lab: costing method for inventory valuation ("WAC", "FIFO", "LIFO")
  costingMethod         String  @default("WAC")
  // Pricing Hub: tab-level default cost % target (JSON: { "wine-btg": 25, "wine-btb": 32, ... })
  pricingTabDefaults    String  @default("{\"wine-btg\":25,\"wine-btb\":32,\"spirits\":22,\"beer\":25,\"na\":18}")
  // Pricing Hub: pour-level cost % targets per tab (JSON: { "wine-btg": { "5oz": 22, "8oz": 25, "btl": 30 }, ... })
  pourSizeTargets       String  @default("{}")
  // Pricing Hub: pricing strategy per tab (JSON: { "wine-btb": { "type": "tiered", ... }, ... })
  pricingStrategies     String  @default("{}")
  // Pricing Hub: tier configs per tab (JSON array of { minCents, maxCents, targetPct })
  pricingTiers          String  @default("{}")
  // Pricing Hub: rounding mode per tab ("none" | "nearest-5" | "nearest-10" | "charm-99")
  pricingRounding       String  @default("{}")
  // Finans Lab: employee names excluded from Server KPI scoring (JSON array of names)
  kpiExcludedEmployees  String  @default("[]")
  // Finans Lab: employee names shown separately (not in leaderboard). PDR Banquet, Online Ordering, etc.
  kpiSpecialAccounts    String  @default("[\"PDR Server 1 Banquet\",\"Default Online Ordering\",\"Unknown\"]")
  // Email settings for sending orders
  orderEmailFrom        String?
  orderEmailFromName    String?
  emailProvider         String  @default("RESEND")
  emailApiKey           String?
  emailSmtpHost         String?
  emailSmtpPort         Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      Membership[]
  invitations  Invitation[]
  categories   Category[]
  recipes      Recipe[]
  ingredients  Ingredient[]
  locations    Location[]
  storageAreas StorageArea[]
  inventoryItems InventoryItem[]
  orderLists   OrderList[]
  vendors      Vendor[]
  productSKUs  ProductSKU[]
  salesSnapshots SalesSnapshot[]
  coverSnapshots CoverSnapshot[]
  orderCountEntries  OrderCountEntry[]
  orderStaffRequests OrderStaffRequest[]

  @@schema("beverage")
}

// ===== UNITS OF MEASURE =====
// Global table shared by all orgs. System-seeded with common units.
// Users can add custom units via settings.

model Unit {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  abbrev      String
  measureType String                // VOLUME, WEIGHT, COUNT
  baseFactor  Float                 // conversion factor to base unit (ml for volume, g for weight, 1 for count)
  canPurchase Boolean @default(true)
  canRecipe   Boolean @default(true)
  isActive    Boolean @default(true)
  isSystem    Boolean @default(true)  // false = user-added
  sortOrder   Int     @default(0)

  productSKUs ProductSKU[]

  @@schema("beverage")
}

// ===== PRODUCT SKU =====
// How a product is purchased from a specific vendor.
// One product can have many SKUs (different vendors, different pack sizes).

model ProductSKU {
  id               String   @id @default(cuid())
  organizationId   String
  ingredientId     String
  vendorId         String?
  name             String            // "Case of 12 × 750ml", "50lb Bag"
  containerType    String            // bottle, case, bag, box, can, pouch, keg, each
  unitsPerPack     Int     @default(1)  // bottles per case, bags per box, etc.
  innerSize        Float             // 750, 1000, 50 etc. (the quantity of the inner unit)
  innerUnitId      String            // FK to Unit (ml, g, each, etc.)
  costCents        Int?              // total cost for this SKU
  isDefault        Boolean @default(false)
  vendorItemNumber String?           // vendor's item/SKU code
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  innerUnit    Unit         @relation(fields: [innerUnitId], references: [id])

  @@schema("beverage")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reps         VendorRep[]
  ingredients  Ingredient[]
  productSKUs  ProductSKU[]

  @@unique([organizationId, name])
  @@schema("beverage")
}

model VendorRep {
  id       String  @id @default(cuid())
  vendorId String
  name     String
  email    String?
  phone    String?
  createdAt DateTime @default(now())

  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  locations VendorRepLocation[]

  @@schema("beverage")
}

model VendorRepLocation {
  id          String @id @default(cuid())
  vendorRepId String
  locationId  String

  vendorRep VendorRep @relation(fields: [vendorRepId], references: [id], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([vendorRepId, locationId])
  @@schema("beverage")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@schema("beverage")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("BARTENDER")
  permissions    String   @default("{}")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@schema("beverage")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String    @default("BARTENDER")
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("beverage")
}

model Category {
  id                   String  @id @default(cuid())
  organizationId       String
  name                 String
  sortOrder            Int     @default(0)
  defaultCostTargetPct Float?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipes      Recipe[]

  @@unique([organizationId, name])
  @@schema("beverage")
}

model Recipe {
  id             String  @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  portionCount   Int     @default(15)
  dilutionPct    Float   @default(0)
  glassType      String?
  iceType        String?
  garnish        String?
  pourFromBatch  String?
  howTo          String?
  storageType    String  @default("NONE")
  noBatching     Boolean @default(false)
  costTargetPct  Float?
  menuPrice      Float?
  notes          String?
  sortOrder      Int     @default(0)
  isArchived     Boolean @default(false)
  // Sub-recipe / House-made fields
  isSubRecipe    Boolean @default(false)   // true = this recipe produces an ingredient
  yieldAmount    Float?                     // how much this recipe makes (e.g., 12)
  yieldUnitCode  String?                    // unit code for yield (e.g., "floz", "ml")
  shelfLifeDays  Int?                       // how long the product lasts
  prepInstructions String?                  // how to make it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category            @relation(fields: [categoryId], references: [id])
  ingredients  RecipeIngredient[]
  // Link back: which ingredient does this recipe produce?
  producesIngredient Ingredient?  @relation("SubRecipe")
  salesMatches       SalesItemSale[] @relation("RecipeSales")

  @@schema("beverage")
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Float
  unit         String  @default("OZ")
  sortOrder    Int     @default(0)
  isTopOff     Boolean @default(false)
  notes        String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@schema("beverage")
}

model Ingredient {
  id                String  @id @default(cuid())
  organizationId    String
  name              String
  type              String  @default("LIQUID")
  // New fields for the UoM system
  productType       String?           // SPIRIT, WINE, BEER, NA_BEVERAGE, CORDIAL, BITTER, SYRUP, HOUSE_MADE, GROCERY, PRODUCE, MEAT, DAIRY, DRY_GOODS, PANTRY, PAPER, CLEANING, OTHER
  baseUnitCode      String?           // "ml", "g", "each" — fundamental unit for recipes/costing
  countUnitCode     String?           // "bottle", "each", "lb" — what staff counts during inventory
  isKeyItem         Boolean @default(false)
  costUpdateMethod  String  @default("MANUAL")  // MANUAL or LAST_RECEIVED
  // House-made / sub-recipe fields
  isHouseMade       Boolean @default(false)
  subRecipeId       String? @unique   // FK to Recipe that produces this ingredient
  // Legacy fields — kept for backward compatibility during transition
  bottleCostCents   Int?
  bottleSizeMl      Int?
  bottleSizeUnit    String  @default("ml") // "ml", "g", "oz", "lb", "kg", "gal"
  yieldCount        Int?    // units per container (e.g., 525 cherries in a 3kg can)
  yieldUnit         String? // "each", "cherry", "leaf", "oz", etc.
  casePackSize      Int?
  // "CASE" | "BOTTLE" | null (= "Not set": staff pick per order line).
  // No Prisma default on purpose: new products start as Not set.
  orderUnit         String?
  purchaseCostCents Int?
  purchaseQty       Float?
  purchaseUnit      String?
  vendor            String?
  vendorId          String?
  ingredientCategory String?
  notes             String?
  onMenu            Boolean @default(true)
  menuStatus        String  @default("ON_MENU")  // ON_MENU, DATABASE, INACTIVE
  markedForRemoval  String?  // null, "INACTIVE", or "DATABASE" — pending removal once out of stock
  isBTG             Boolean @default(false)  // By-The-Glass wine flag
  isCraftCocktailIngredient Boolean @default(false)  // Used in craft cocktails
  isWellSpirit      Boolean @default(false)  // Well/house spirit
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorRef       Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subRecipe       Recipe?            @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  inventoryItems  InventoryItem[]
  orderItems      OrderListItem[]
  productSKUs     ProductSKU[]
  pricings        IngredientPrice[]
  salesMatches    SalesItemSale[] @relation("IngredientSales")
  orderCountEntries OrderCountEntry[]

  @@unique([organizationId, name])
  @@schema("beverage")
}

// Pricing Hub: one row per pour size per ingredient.
// Example: a BTG wine has 3 rows (5oz, 8oz, 750ml), each with its own menu price.
// A single-pour spirit has 1 row. Raki can have 4 (single, double, 1/2 btl, full btl).
model IngredientPrice {
  id               String  @id @default(cuid())
  ingredientId     String
  label            String   // human label: "5oz", "8oz", "btl", "single", "double", "1/2 btl", "full btl"
  pourMl           Float    // volume per pour in milliliters (used to compute cost)
  menuPriceCents   Int?     // null = price not set yet
  costTargetPct    Float?   // per-pour override; null = inherit from tab/category default
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, label])
  @@schema("beverage")
}

model Location {
  id             String @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int    @default(0)
  createdAt      DateTime @default(now())
  // Link to the Schedule store (public.locations.id) — staff roster + PINs
  scheduleLocationId String? @unique @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageAreas   StorageArea[]
  inventoryItems InventoryItem[]
  orderLists     OrderList[]
  vendorReps     VendorRepLocation[]
  salesSnapshots SalesSnapshot[]
  coverSnapshots CoverSnapshot[]
  orderCountLink     OrderCountLink?
  orderingScopes     OrderingStoreScope[]
  orderCountEntries  OrderCountEntry[]
  orderStaffRequests OrderStaffRequest[]

  @@unique([organizationId, name])
  @@schema("beverage")
}

model StorageArea {
  id             String @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  sortOrder      Int    @default(0)
  createdAt      DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stockCounts     StockCount[]
  inventoryItems  InventoryItem[] @relation("StorageArea1")
  inventoryItems2 InventoryItem[] @relation("StorageArea2")
  orderCountEntries OrderCountEntry[]

  @@unique([locationId, name])
  @@schema("beverage")
}

model InventoryItem {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String
  ingredientId   String
  storageAreaId  String?
  shelfLocation  String?
  storageArea2Id String?
  shelfLocation2 String?
  isBTG          Boolean @default(false)
  isCraftCocktailIngredient Boolean @default(false)
  isWellSpirit   Boolean @default(false)
  isHalfBottle   Boolean @default(false)
  isDessertWine  Boolean @default(false)
  markedForRemoval String?  // null, "INACTIVE", or "DATABASE"
  parLevel       Float   @default(0)
  currentStock   Float   @default(0)
  unit           String  @default("bottle")
  lastCountedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  storageArea  StorageArea? @relation("StorageArea1", fields: [storageAreaId], references: [id], onDelete: SetNull)
  storageArea2 StorageArea? @relation("StorageArea2", fields: [storageArea2Id], references: [id], onDelete: SetNull)
  stockCounts  StockCount[]
  orderCountEntries OrderCountEntry[]

  @@unique([locationId, ingredientId])
  @@schema("beverage")
}

model StockCount {
  id              String   @id @default(cuid())
  inventoryItemId String
  storageAreaId   String?
  count           Float
  countedAt       DateTime @default(now())
  countedBy       String?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  storageArea   StorageArea?  @relation(fields: [storageAreaId], references: [id], onDelete: SetNull)

  @@schema("beverage")
}

model OrderList {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  // Status flow: IN_PROGRESS → SUBMITTED → APPROVED → ORDERED.
  // (Downstream SENT / RECEIVED states are still used by the receiving flow.)
  status         String   @default("IN_PROGRESS")
  notes          String?
  createdBy      String?         // userId of the manager who built the order
  createdByName  String?
  // Approval workflow
  submittedAt    DateTime?       // set when manager submits for approval
  approvedAt     DateTime?       // set when owner/admin approves
  approvedBy     String?         // userId of the approver
  approvedByName String?
  reviewNote     String?         // owner's "send back" note returned to the manager
  countedAt      DateTime?
  // Staff Ordering: who sent it from the staff count page
  submittedById   String?
  submittedByName String?
  source          String?        // 'staff' | 'manager'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items        OrderListItem[]
  countEntries  OrderCountEntry[]
  staffRequests OrderStaffRequest[]

  @@schema("beverage")
}

model OrderListItem {
  id             String  @id @default(cuid())
  orderListId    String
  ingredientId   String
  vendor         String?
  countedStock   Float?
  parSnapshot    Float?
  quantityNeeded Float
  unit           String  @default("bottle")
  status         String  @default("PENDING")   // PENDING | REJECTED (rejected by reviewer)
  storageArea    String?
  notes          String?
  // Internal transfer notes (requirement 4). When a reviewer moves a line from
  // one store's order to another store's order for the same vendor, the line is
  // reassigned to the receiving store's order and these fields record where it
  // came from. Vendor-facing email shows only the combined quantity under the
  // receiving store — the transfer is internal-only.
  transferFromLocationId String?
  transferToLocationId   String?
  transferNote           String?  // e.g. "3 units via transfer from Palo Alto"
  // Staff Ordering: who counted, unit pick (this line only), move + transfer
  // tracking, and cost / case size as they were at the time (Transfers history).
  countedById           String?
  countedByName         String?
  countedAt             DateTime?
  source                String?   // 'staff' | 'manager'
  unitIsStaffPick       Boolean?  @default(false)
  movedById             String?
  movedByName           String?
  movedAt               DateTime?
  transferStatus        String?   // 'PENDING' | 'TRANSFERRED'
  transferredAt         DateTime?
  transferredById       String?
  transferredByName     String?
  unitCostCentsSnapshot Int?
  casePackSizeSnapshot  Int?

  orderList  OrderList  @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@schema("beverage")
}

model OrderEmail {
  id             String   @id @default(cuid())
  organizationId String
  orderListId    String?
  vendorName     String
  recipientEmail String
  recipientName  String?
  subject        String
  body           String
  status         String   @default("DRAFT")  // DRAFT, SENT, FAILED
  sentAt         DateTime?
  errorMessage   String?
  // Staff Ordering: store + manual "Mark as sent" (emails are copied, never auto-sent)
  locationId       String?
  markedSentById   String?
  markedSentByName String?
  markedSentAt     DateTime?
  createdAt      DateTime @default(now())

  @@schema("beverage")
}

// =============================================================================
// PRICING HUB — SALES DATA LAYER
// =============================================================================
// Sales data from POS (Toast) uploaded manually as CSV exports (per-location,
// per-period). When the Toast API is wired up later, the same tables are
// populated automatically. UI reads from these tables to show velocity,
// dormant alerts, annual performance, etc.

model SalesSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?       // null = all locations (aggregated upload)
  // Period covered by this snapshot
  periodStart    DateTime       // inclusive (YYYY-MM-DD 00:00)
  periodEnd      DateTime       // inclusive (YYYY-MM-DD 23:59)
  // Upload metadata
  source         String  @default("CSV_UPLOAD")  // "CSV_UPLOAD" | "TOAST_API"
  sourceFilename String?                         // original folder/file name
  // Roll-up totals (for quick UI)
  totalQtySold    Float  @default(0)
  totalGrossCents Int    @default(0)
  totalNetCents   Int    @default(0)
  itemsMatched    Int    @default(0)   // how many PMIX rows matched a DB product
  itemsUnmatched  Int    @default(0)   // how many rows could not be matched
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  itemSales      SalesItemSale[]
  groupSales     SalesMenuGroupSale[]

  @@index([organizationId, locationId, periodStart])
  @@schema("beverage")
}

model SalesItemSale {
  id             String   @id @default(cuid())
  snapshotId     String
  // Raw Toast row data (so we can reanalyze without re-uploading)
  rawItemName    String                        // as it appeared in PMIX
  rawMenu        String?                       // menu heading (DINNER Menu, etc.)
  rawMenuGroup   String?                       // menu group (HALF BOTTLES, BTG Red, etc.)
  // Quantities + money (money kept in cents for precision)
  qtySold        Float
  avgPriceCents  Int    @default(0)
  netCents       Int    @default(0)
  grossCents     Int    @default(0)
  discountCents  Int    @default(0)
  voidCents      Int    @default(0)
  // Matching: a sale can map to an Ingredient (beverages) or a Recipe (cocktails/food)
  matchedIngredientId String?
  matchedRecipeId     String?
  matchConfidence     Float?    // 0-1, how strong the fuzzy match was
  matchUserConfirmed  Boolean @default(false)

  snapshot            SalesSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  matchedIngredient   Ingredient?   @relation("IngredientSales", fields: [matchedIngredientId], references: [id], onDelete: SetNull)
  matchedRecipe       Recipe?       @relation("RecipeSales", fields: [matchedRecipeId], references: [id], onDelete: SetNull)

  @@index([snapshotId])
  @@index([matchedIngredientId])
  @@index([matchedRecipeId])
  @@schema("beverage")
}

model SalesMenuGroupSale {
  id           String @id @default(cuid())
  snapshotId   String
  menu         String?                    // DINNER Menu, BOTTLE WINE, etc.
  menuGroup    String                      // HALF BOTTLES, BTG Red, etc.
  qtySold      Float
  avgPriceCents Int   @default(0)
  netCents     Int    @default(0)

  snapshot     SalesSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, menuGroup])
  @@schema("beverage")
}

// ============================================================================
// OpenTable covers (guest counts) — imported from OpenTable Reservations CSV.
// Pairs with SalesSnapshot to compute spend-per-cover / prime cost.
// ============================================================================
model CoverSnapshot {
  id                String   @id @default(cuid())
  organizationId    String
  locationId        String?  // null = all locations (aggregated)
  periodStart       DateTime // inclusive
  periodEnd         DateTime // inclusive
  source            String   @default("OPENTABLE_CSV")
  sourceFilename    String?
  totalCovers       Int      @default(0)
  totalReservations Int      @default(0)
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  days         CoverDay[]

  @@index([organizationId, locationId, periodStart])
  @@schema("beverage")
}

model CoverDay {
  id           String   @id @default(cuid())
  snapshotId   String
  date         DateTime
  service      String   // "lunch" | "dinner"
  covers       Int      @default(0)
  reservations Int      @default(0)

  snapshot CoverSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, date])
  @@schema("beverage")
}

// ============================================================================
// STAFF ORDERING (migration 20260928000000_staff_ordering)
// ============================================================================

// One secret staff count-page link per store (like public.tip_entry_links).
model OrderCountLink {
  locationId    String    @id
  token         String    @unique
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  rotatedAt     DateTime?
  createdById   String?
  createdByName String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@schema("beverage")
}

// Which stores each person orders for (ORDER) or can only see (VIEW).
// profileId = public.profiles.id (the Supabase user id).
model OrderingStoreScope {
  id          String   @id @default(cuid())
  profileId   String   @db.Uuid
  locationId  String
  access      String // ORDER | VIEW
  createdAt   DateTime @default(now())
  createdById String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([profileId, locationId])
  @@schema("beverage")
}

// Every staff count ever sent. OrderListItem holds the latest; older ones get supersededAt.
model OrderCountEntry {
  id              String    @id @default(cuid())
  organizationId  String
  locationId      String
  orderListId     String?
  ingredientId    String
  inventoryItemId String?
  storageAreaId   String?
  storageAreaName String?
  count           Float
  unitPick        String? // CASE | BOTTLE, staff pick when the admin has not set a unit
  countedById     String?
  countedByName   String?
  countedAt       DateTime  @default(now())
  supersededAt    DateTime?
  createdAt       DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orderList     OrderList?     @relation(fields: [orderListId], references: [id], onDelete: SetNull)
  ingredient    Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  storageArea   StorageArea?   @relation(fields: [storageAreaId], references: [id], onDelete: SetNull)

  @@index([locationId, countedAt])
  @@index([orderListId])
  @@schema("beverage")
}

// Free-text "something else" lines from the staff page.
model OrderStaffRequest {
  id              String    @id @default(cuid())
  organizationId  String
  locationId      String
  orderListId     String?
  text            String
  status          String    @default("OPEN") // OPEN | ADDED | DISMISSED
  requestedById   String?
  requestedByName String?
  createdAt       DateTime  @default(now())
  resolvedById    String?
  resolvedByName  String?
  resolvedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orderList    OrderList?   @relation(fields: [orderListId], references: [id], onDelete: SetNull)

  @@index([orderListId])
  @@schema("beverage")
}

// Append-only history of every staff / manager / Transfers change. No relations
// on purpose so history survives deletes (like public.tip_input_log).
model OrderActivityLog {
  id              String   @id @default(cuid())
  organizationId  String
  locationId      String?
  orderListId     String?
  orderListItemId String?
  ingredientId    String?
  entity          String // ORDER | LINE | PRODUCT | PIN | LINK | EMAIL | TRANSFER | REQUEST | SCOPE
  action          String
  field           String?
  oldValue        String?
  newValue        String?
  actorId         String?
  actorName       String?
  actorKind       String // staff | manager | system
  source          String? // staff_count | review | transfers | admin
  note            String?
  at              DateTime @default(now())

  @@index([organizationId, at(sort: Desc)], map: "OrderActivityLog_org_at_idx")
  @@index([orderListId])
  @@index([ingredientId])
  @@schema("beverage")
}

// ---------------------------------------------------------------------------
// Bar Recipe Book (docs/recipe-book/Recipe_Book_Build_Spec.md). Separate from the
// costing Recipe/RecipeIngredient above. Created by migration
// 20260929000000_bar_recipe_book (applied via Supabase MCP, not prisma migrate).
// Translatable text is Json {"en","tr","es"}.
// ---------------------------------------------------------------------------
model BarRecipe {
  id              String    @id
  name            String
  subtitle        Json?
  photoPath       String?   @map("photo_path")
  category        String // craft | classic | na | syrup
  stores          String[]  @default(["meyhouse", "meze-kebab"])
  scaleMode       String    @default("none") @map("scale_mode") // portions | liters | multiplier | none
  batchable       Boolean   @default(false)
  defaultPortions Decimal?  @map("default_portions") @db.Decimal
  dilutionPct     Decimal   @default(0) @map("dilution_pct") @db.Decimal // 0.2 = 20%
  pourFromBatchOz Decimal?  @map("pour_from_batch_oz") @db.Decimal
  glass           Json?
  ice             Json?
  garnish         Json?
  howTo           Json?     @map("how_to")
  storage         String? // freezer | fridge
  notes           Json?
  method          Json? // {"en": [steps], "tr": [...], "es": [...]}
  baseYieldL      Decimal?  @map("base_yield_l") @db.Decimal
  glassL          Decimal?  @map("glass_l") @db.Decimal
  needsReview     Boolean   @default(false) @map("needs_review")
  needsSpec       Boolean   @default(false) @map("needs_spec")
  active          Boolean   @default(true)
  sortOrder       Int       @default(0) @map("sort_order")
  updatedBy       String?   @map("updated_by") @db.Uuid
  updatedByName   String?   @map("updated_by_name")
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ingredients BarRecipeIngredient[]

  @@map("bar_recipe")
  @@schema("beverage")
}

model BarRecipeIngredient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String   @map("recipe_id")
  sortOrder Int      @default(0) @map("sort_order")
  name      Json
  batchName String?  @map("batch_name")
  qty       Decimal? @db.Decimal
  unit      String? // oz | dash | kg | g | L | ea | cup | ml
  text      Json?
  inBatch   Boolean  @default(true) @map("in_batch")
  note      Json?

  recipe BarRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, sortOrder], map: "bar_recipe_ingredient_recipe_idx")
  @@map("bar_recipe_ingredient")
  @@schema("beverage")
}

// Append-only: a DB trigger refuses UPDATE / DELETE / TRUNCATE for every role.
model BarRecipeChangeLog {
  id                BigInt   @id @default(autoincrement())
  recipeId          String   @map("recipe_id")
  changedByPersonId String?  @map("changed_by_person_id") @db.Uuid
  changedByName     String   @map("changed_by_name")
  changedAt         DateTime @default(now()) @map("changed_at") @db.Timestamptz
  source            String // staff_page | admin
  device            String?
  language          String? // en | tr | es
  action            String // create | update | archive | restore | revert
  revertedLogId     BigInt?  @map("reverted_log_id")
  before            Json?
  after             Json
  summary           String

  @@index([recipeId, changedAt(sort: Desc)], map: "bar_recipe_change_log_recipe_idx")
  @@index([changedAt(sort: Desc)], map: "bar_recipe_change_log_time_idx")
  @@map("bar_recipe_change_log")
  @@schema("beverage")
}

// "Recipe access" per Schedule position (public.positions.id). No row = off.
model PositionRecipeAccess {
  positionId    String   @id @map("position_id") @db.Uuid
  enabled       Boolean  @default(false)
  updatedBy     String?  @map("updated_by") @db.Uuid
  updatedByName String?  @map("updated_by_name")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("position_recipe_access")
  @@schema("beverage")
}

// The ONE staff Recipe Book link for the whole group (single row, id = 1).
model BarRecipeLink {
  id            Int       @id @default(1) @db.SmallInt
  token         String    @unique
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz
  createdById   String?   @map("created_by_id") @db.Uuid
  createdByName String?   @map("created_by_name")

  @@map("bar_recipe_link")
  @@schema("beverage")
}

// Monthly beverage budget (Product Hub header widget). One row per month.
model BudgetMonth {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String   @map("organization_id")
  month          String // 'YYYY-MM'
  budgetCents    Int      @map("budget_cents")
  pendingCents   Int      @default(0) @map("pending_cents")
  pendingNote    String?  @map("pending_note")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@unique([organizationId, month])
  @@map("budget_month")
  @@schema("beverage")
}

// Invoices logged against a month's budget. counted = false: logged only.
model BudgetInvoice {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String   @map("organization_id")
  month          String // 'YYYY-MM'
  locationId     String   @map("location_id")
  vendor         String
  invoiceNumber  String   @map("invoice_number")
  invoiceDate    DateTime @map("invoice_date") @db.Date
  amountCents    Int      @map("amount_cents")
  counted        Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([organizationId, month], map: "budget_invoice_org_month")
  @@map("budget_invoice")
  @@schema("beverage")
}
